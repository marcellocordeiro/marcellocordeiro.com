---
import ProjectList from "@/components/projects/ProjectList.astro";
import Link from "@/components/ui/link/Link.astro";
import Layout from "@/layouts/Layout.astro";
import { getBlogPosts } from "@/lib/blog";
import { getProjects } from "@/lib/projects";
---

<Layout>
  <article class="space-y-12">
    <section class="space-y-4">
      <h2 class="text-xl font-semibold tracking-tight">About Me</h2>

      <div class="max-w-2xl space-y-4 leading-7 text-muted-foreground">
        <p>
          Hi! I'm Marcello. I'm a Software Engineer. I have experience building native macOS and iOS
          applications, from writing UI code to developing and maintaining shared libraries across
          teams. I enjoy experimenting and working on new solutions to improve both the developer
          and the user experience.
        </p>
        <p>
          In my free time I enjoy playing games and working on fun projects. I've written a few
          emulators as challenges to develop new skills and learn new programming languages. I have
          also written this entire website from the scratch as way to brush up my web development
          skills, which still needs a ton of improvements, oops.
        </p>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-xl font-semibold tracking-tight">Projects</h2>
      <ProjectList projects={getProjects()} />
    </section>

    <section class="space-y-4">
      <h2 class="text-xl font-semibold tracking-tight">Programming Languages And Tools</h2>

      <p class="leading-7 text-muted-foreground">
        I have 4 years of professional experience writing Swift, but I can also comfortably write
        Rust, C, C++ and JavaScript/TypeScript. I'll also play with Python and other languages
        whenever they fit the situation.
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="text-xl font-semibold tracking-tight">Blog Posts</h2>

      <ul class="divide-y [&>:not(:last-child)]:mb-3 [&>:not(:last-child)]:pb-3">
        {getBlogPosts().map((post) => (
          <li>
            <Link href={`/blog/${post.data.slug}`}>{post.data.title}</Link>
          </li>
        ))}
      </ul>
    </section>
  </article>
</Layout>

<style>
  article {
    @media (prefers-reduced-motion: no-preference) {
      --_duration: 75ms;

      opacity: 1;
      transition: opacity var(--_duration) ease-out;
      transition-delay: calc(sibling-index() * var(--_duration));

      @starting-style {
        opacity: 0;
      }
    }
  }
</style>
