---
import PostCardLink from "@/components/blog/PostCardLink.astro";
import { SITE_TITLE } from "@/config/constants";
import Layout from "@/layouts/Layout.astro";
import { getBlogPosts } from "@/lib/blog";

const posts = getBlogPosts();
---

<Layout title=`Blog | ${SITE_TITLE}`>
  <div class="space-y-8">
    <header class="space-y-2">
      <h1 class="text-3xl font-semibold tracking-tight">Blog</h1>
      <p class="text-muted-foreground">
        Notes on software, experiments, and things I'm learning.
      </p>
    </header>

    <div class="grid w-full grid-cols-1 gap-4">
      {posts.map((post) => (
        <PostCardLink post={post} />
      ))}
    </div>
  </div>
</Layout>
