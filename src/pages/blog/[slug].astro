---
import { render } from "astro:content";

import PostPager from "@/components/blog/post-pager/PostPager.astro";
import PostMetadata from "@/components/blog/PostMetadata.astro";
import Link from "@/components/ui/link/Link.astro";
import Prose from "@/components/ui/Prose.astro";
import Separator from "@/components/ui/Separator.astro";
import { SITE_TITLE } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import { getBlogPostWindows, type Post } from "@/lib/blog";

export function getStaticPaths() {
  const windows = getBlogPostWindows();
  return windows.map(({ previous, current, next }) => ({
    params: { slug: current.id },
    props: { previous, current, next },
  }));
}

interface Props {
  previous?: Post;
  current: Post;
  next?: Post;
}

const { previous, current, next } = Astro.props;
const { title } = current.data;
const { Content, remarkPluginFrontmatter } = await render(current);
---

<Layout title=`${title} | ${SITE_TITLE}`>
  <Prose>
    <Link href="/blog">{"<- Back"}</Link>

    <h1 class="mt-4">{title}</h1>

    <PostMetadata
      post={current}
      extraMetadata={remarkPluginFrontmatter}
      showUpdated
    />

    <Content />

    <Separator />

    <div>
      <div>
        <p>Tags:</p>
        {current.data.tags.map((t) => (
          <p>{t}</p>
        ))}
      </div>

      <PostPager previous={previous} next={next} />
    </div>
  </Prose>
</Layout>
