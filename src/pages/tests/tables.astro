---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Tables">
  <article class="prose">
    <table>
      <caption>With caption</caption>
      <thead>
        <tr>
          <th>Tables</th>
          <th align="center">Are</th>
          <th align="right">Cool</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>col 3 is</td>
          <td align="center">right-aligned</td>
          <td align="right">$1600</td>
        </tr>
        <tr>
          <td>col 2 is</td>
          <td align="center">centered</td>
          <td align="right">$12</td>
        </tr>
        <tr>
          <td>zebra stripes</td>
          <td align="center">are neat</td>
          <td align="right">$1</td>
        </tr>
      </tbody>
      <tfoot>
        <tr>
          <td>
            <strong>Total</strong>
          </td>
          <td align="center">
            <strong>$30.00</strong>
          </td>
          <td align="right">
            <strong>$60.00</strong>
          </td>
        </tr>
      </tfoot>
    </table>

    <p>Vertical table</p>

    <table>
      <tbody>
        <tr>
          <th>Name</th>
          <td>John</td>
          <td>Jane</td>
          <td>Mike</td>
          <td>Emma</td>
        </tr>
        <tr>
          <th>Age</th>
          <td>25</td>
          <td>30</td>
          <td>28</td>
          <td>27</td>
        </tr>
        <tr>
          <th>City</th>
          <td>New York</td>
          <td>London</td>
          <td>Paris</td>
          <td>Tokyo</td>
        </tr>
      </tbody>
    </table>

    <p>Diagonal table</p>
    <table>
      <thead>
        <tr>
          <th></th>
          <th>Product A</th>
          <th>Product B</th>
          <th>Product C</th>
          <th>Product D</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <th>Feature 1</th>
          <td>Yes</td>
          <td>No</td>
          <td>Yes</td>
          <td>No</td>
        </tr>
        <tr>
          <th>Feature 2</th>
          <td>No</td>
          <td>Yes</td>
          <td>No</td>
          <td>Yes</td>
        </tr>
        <tr>
          <th>Feature 3</th>
          <td>Yes</td>
          <td>Yes</td>
          <td>No</td>
          <td>No</td>
        </tr>
      </tbody>
    </table>

    <p>Multi-header table</p>

    <table>
      <thead>
        <tr>
          <th rowspan="2">ID</th>
          <th colspan="2">Personal Info</th>
          <th colspan="2">Contact Info</th>
        </tr>
        <tr>
          <th>Name</th>
          <th>Age</th>
          <th>Email</th>
          <th>Phone</th>
        </tr>
      </thead>
      <tr>
        <td>1</td>
        <td>John</td>
        <td>25</td>
        <td>john@example.com</td>
        <td>123-456</td>
      </tr>
      <tr>
        <td>2</td>
        <td>Jane</td>
        <td>30</td>
        <td>jane@example.com</td>
        <td>789-012</td>
      </tr>
      <tr>
        <td>3</td>
        <td>Mike</td>
        <td>28</td>
        <td>mike@example.com</td>
        <td>345-678</td>
      </tr>
    </table>

    <p>Multi-column vertical table</p>

    <table>
      <thead>
        <tr>
          <th colspan="2">Student 1</th>
          <th colspan="2">Student 2</th>
          <th colspan="2">Student 3</th>
        </tr>
      </thead>
      <tr>
        <th>Name</th>
        <td>John</td>
        <th>Name</th>
        <td>Jane</td>
        <th>Name</th>
        <td>Mike</td>
      </tr>
      <tr>
        <th>Age</th>
        <td>25</td>
        <th>Age</th>
        <td>30</td>
        <th>Age</th>
        <td>28</td>
      </tr>
      <tr>
        <th>City</th>
        <td>New York</td>
        <th>City</th>
        <td>London</td>
        <th>City</th>
        <td>Paris</td>
      </tr>
    </table>
  </article>
</Layout>
