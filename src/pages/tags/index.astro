---
import Badge from "@/components/ui/badge/Badge.astro";
import Link from "@/components/ui/link/Link.astro";
import Layout from "@/layouts/Layout.astro";
import { getBlogPostsTags } from "@/lib/blog";

const tags = getBlogPostsTags();
---

<Layout title="Tags">
  <div class="space-y-8">
    <div class="space-y-2">
      <Link href="/blog">Back to blog</Link>
      <h1 class="text-3xl font-semibold tracking-tight">Tags</h1>
    </div>

    {tags.length > 0 && (
      <ul class="space-y-1.5 space-x-1.5">
        {tags.map((tag) => (
          <li>
            <Link href={`/tags/${encodeURIComponent(tag)}`}>
              <Badge as="span" variant="secondary">
                {tag}
              </Badge>
            </Link>
          </li>
        ))}
      </ul>
    )}
  </div>
</Layout>
