---
import { render } from "astro:content";

import BackToTop from "@/components/BackToTop.astro";
import PostPager from "@/components/blog/post-pager/PostPager.astro";
import PostMetadata from "@/components/blog/PostMetadata.astro";
import ReadingProgress from "@/components/ReadingProgress.astro";
import Badge from "@/components/ui/badge/Badge.astro";
import Link from "@/components/ui/link/Link.astro";
import Separator from "@/components/ui/Separator.astro";
import { ChevronLeftIcon } from "@/config/icons";
import Layout from "@/layouts/Layout.astro";
import { type Post } from "@/lib/blog";

interface Props {
  previous: Post | undefined;
  current: Post;
  next: Post | undefined;
}

const { previous, current, next } = Astro.props;
const { title } = current.data;
const { Content, remarkPluginFrontmatter } = await render(current);
---

<Layout title={title}>
  <article class="prose prose-article mx-auto max-w-[65ch]">
    <Link class="group inline-flex items-center gap-1" href="/blog">
      <ChevronLeftIcon class="size-4" aria-hidden="true" />
      <span>Back</span>
    </Link>

    <h1 class="mt-4">{title}</h1>

    <PostMetadata post={current} pluginMetadata={remarkPluginFrontmatter} />

    {current.data.tags.length > 0 && (
      <ul class="not-prose mt-5 flex flex-wrap gap-1.5" aria-label={`${current.data.title} tags`}>
        {current.data.tags.map((tag) => (
          <Badge as="li" variant="secondary">
            {tag}
          </Badge>
        ))}
      </ul>
    )}

    <Content />
    <ReadingProgress />
  </article>

  {(previous || next) && (
    <div class="flex flex-col gap-6">
      <Separator class="mt-6" />

      <PostPager previous={previous} next={next} />
    </div>
  )}

  <BackToTop />
</Layout>
