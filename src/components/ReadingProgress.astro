---
import type { HTMLAttributes } from "astro/types";

type Props = Pick<HTMLAttributes<"article">, "class">;

const { class: className } = Astro.props;
---

<div class:list={["reading-progress", className]} aria-hidden="true" />

<style>
  /* "fallback" if the user's browser doesn't support scroll-driven animations */
  .reading-progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .reading-progress {
      /* fallback */
      display: block;

      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      inline-size: 100%;
      height: 4px;

      background-color: var(--primary);

      transform-origin: left center;
      animation: expand linear;
    }

    @keyframes expand {
      from {
        transform: scaleX(0);
      }
    }
  }

  /* https://github.com/parcel-bundler/lightningcss/issues/1283 */
  .reading-progress {
    animation-timeline: scroll();
  }
</style>
