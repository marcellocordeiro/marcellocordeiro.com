---
import { DesktopHeader } from "./desktop-header";
import { MobileHeader } from "./mobile-header";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<DesktopHeader className="[grid-area:header] not-md:hidden" {pathname} />
<MobileHeader className="[grid-area:header] md:hidden" {pathname} client:load />
