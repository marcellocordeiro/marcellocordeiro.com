---
import { AUTHOR } from "@/config/constants";
import { MenuIcon, CloseIcon } from "@/config/icons";
import Button from "@/components/ui/button/Button.astro";
import Link from "@/components/ui/link/Link.astro";

import HeaderNavigationItems from "./HeaderNavigationItems.astro";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<custom-header>
  <header class="border-b bg-background/80 backdrop-blur">
    <div class="mx-auto flex max-w-3xl items-center justify-between py-4 px-4">
      <Link class="text-lg font-semibold tracking-tight" href="/">
        {AUTHOR.name}
      </Link>

      <nav class="hidden md:block">
        <ul class="flex gap-4">
          <HeaderNavigationItems pathname={pathname} />
        </ul>
      </nav>

      <Button
        id="mobile-menu-toggle"
        class="transition-transform duration-200 group md:hidden aria-expanded:rotate-90 not-aria-expanded:rotate-0"
        variant="outline"
        size="icon"
        aria-label={"Toggle menu"}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <MenuIcon class="group-aria-expanded:hidden" />
        <CloseIcon class="hidden group-aria-expanded:block" />
      </Button>
    </div>

    <nav id="mobile-menu" class="hidden border-t md:hidden">
      <ul class="flex flex-col gap-1 px-4 py-3">
        <HeaderNavigationItems pathname={pathname} />
      </ul>
    </nav>
  </header>
</custom-header>

<style>
  custom-header {
    display: contents;
  }
</style>

<script>
  class CustomHeader extends HTMLElement {
    connectedCallback() {
      const toggleButton = this.querySelector("#mobile-menu-toggle");
      const mobileMenu = this.querySelector("#mobile-menu");

      toggleButton?.addEventListener("click", () => {
        const isExpanded =
          toggleButton.getAttribute("aria-expanded") === "true";

        toggleButton.setAttribute("aria-expanded", String(!isExpanded));
        mobileMenu?.classList.toggle("hidden");
      });
    }
  }

  customElements.define("custom-header", CustomHeader);
</script>
