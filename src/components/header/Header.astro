---
import Button from "@/components/ui/button/Button.astro";
import Link from "@/components/ui/link/Link.astro";
import { XIcon, MenuIcon } from "@/config/icons";
import { AUTHOR } from "@/config/site";

import HeaderNavigationItems from "./HeaderNavigationItems.astro";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<header class="header group/header">
  <div class="header-inner">
    <Link class="text-lg font-semibold tracking-tight" href="/">
      {AUTHOR.name}
    </Link>

    <nav class="desktop-menu">
      <ul>
        <HeaderNavigationItems pathname={pathname} />
      </ul>
    </nav>

    <Button
      id="mobile-menu-toggle"
      class="size-9 transition-transform duration-200 group-has-[:popover-open]/header:rotate-90 md:hidden"
      variant="outline"
      size="icon"
      aria-label="Toggle menu"
      popovertarget="mobile-menu"
    >
      <MenuIcon class="group-has-[:popover-open]/header:hidden" aria-hidden="true" />
      <XIcon class="hidden group-has-[:popover-open]/header:block" aria-hidden="true" />
    </Button>

    <nav id="mobile-menu" class="mobile-menu" popover>
      <ul>
        <HeaderNavigationItems pathname={pathname} />
      </ul>
    </nav>
  </div>
</header>
