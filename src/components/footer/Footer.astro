---
import ThemeToggle from "@/components/theme/ThemeToggle.astro";
import { COPYRIGHT } from "@/config/constants";
import Link from "@/components/Link.astro";

import FooterSocials from "./FooterSocials.astro";
---

<footer class="border-t py-8">
  <div class="mx-auto max-w-3xl px-10">
    <div class="flex flex-row flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-sm text-muted-foreground">
          {COPYRIGHT} · <Link href="/rss.xml">RSS</Link>
        </p>
        <FooterSocials />
      </div>

      <ThemeToggle />
    </div>
  </div>
</footer>

<style>
  footer {
    grid-area: footer;
  }
</style>
