---
import ThemeToggle from "@/components/theme/ThemeToggle.astro";
import { COPYRIGHT } from "@/config/site";
import Link from "@/components/ui/link/Link.astro";

import FooterSocials from "./FooterSocials.astro";
---

<footer class="border-t py-6 sm:py-8">
  <div class="mx-auto max-w-3xl px-4">
    <div class="flex flex-col items-center gap-6 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left">
      <div class="space-y-2">
        <p class="text-sm text-muted-foreground">
          {COPYRIGHT} · <Link href="/rss.xml">RSS</Link>
        </p>
        <FooterSocials />
      </div>

      <ThemeToggle />
    </div>
  </div>
</footer>

<style>
  footer {
    grid-area: footer;
  }
</style>
