---
import Link from "@/components/ui/link/Link.astro";
import { SOCIALS } from "@/config/navigation-items";
---

<div class="flex items-center justify-center gap-1 sm:justify-start">
  {SOCIALS.map((item) => (
    <Link
      href={item.href}
      aria-label={item.label}
      showExternalLinkIcon={false}
      class="button"
      data-variant="ghost"
      data-size="icon"
    >
      <item.Icon />
    </Link>
  ))}
</div>
