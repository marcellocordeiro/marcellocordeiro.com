---
import { ClockIcon } from "@/config/icons";
import type { Post } from "@/lib/blog";

interface Props {
  post: Post;
  pluginMetadata: {
    lastModified?: Date;
    minutesRead?: string;
  };
}

const {
  post: {
    data: { pubDate },
  },
  pluginMetadata: { lastModified, minutesRead },
} = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    timeZone: "UTC",
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<div class="flex flex-col flex-wrap gap-1 text-sm text-muted-foreground">
  <span class="flex items-center gap-1">
    <ClockIcon aria-hidden="true" />
    <span>Published</span>
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
  </span>

  {(lastModified || minutesRead) && (
    <div class="flex flex-wrap gap-x-3 gap-y-1">
      {lastModified && (
        <span>
          Updated <time datetime={lastModified.toISOString()}>{formatDate(lastModified)}</time>
        </span>
      )}

      {lastModified && minutesRead && <span aria-hidden="true">·</span>}

      {minutesRead && <span>{minutesRead}</span>}
    </div>
  )}
</div>
