---
import { ClockIcon } from "@/config/icons";
import type { Post } from "@/lib/blog";

interface Props {
  post: Post;
  extraMetadata: {
    lastModified?: string;
    minutesRead?: string;
  };
}

const {
  post: {
    data: { pubDate },
  },
  extraMetadata: { lastModified, minutesRead },
} = Astro.props;

const formatDate = (date: Date | string) =>
  new Date(date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<div class="flex flex-col flex-wrap gap-1 text-sm text-muted-foreground">
  <span class="flex items-center gap-1">
    <ClockIcon aria-hidden="true" />
    <span>Published</span>
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
  </span>

  {(lastModified || minutesRead) && (
    <div class="flex flex-wrap gap-x-3 gap-y-1">
      {lastModified && (
        <span>
          Updated <time datetime={lastModified}>{formatDate(lastModified)}</time>
        </span>
      )}

      {minutesRead && (
        <>
          <span aria-hidden="true">·</span>
          <span>{minutesRead}</span>
        </>
      )}
    </div>
  )}
</div>
