---
import { ClockIcon } from "@/config/icons";
import type { Post } from "@/lib/blog";

interface Props {
  post: Post;
  extraMetadata: {
    lastModified?: string;
    minutesRead?: string;
  };
}

const { post, extraMetadata } = Astro.props;

const formatDate = (date: Date | string) =>
  new Date(date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<div class="flex flex-col flex-wrap gap-1 text-sm text-muted-foreground">
  <span class="flex items-center gap-1">
    <ClockIcon aria-hidden="true" />
    <span>Published</span>
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
  </span>

  {(extraMetadata.lastModified || extraMetadata.minutesRead) && (
    <div class="flex flex-wrap gap-x-3 gap-y-1">
      {extraMetadata.lastModified && (
        <span>
          Updated{" "}
          <time datetime={extraMetadata.lastModified}>
            {formatDate(extraMetadata.lastModified)}
          </time>
        </span>
      )}

      {extraMetadata.minutesRead && (
        <>
          <span aria-hidden="true">·</span>
          <span>{extraMetadata.minutesRead}</span>
        </>
      )}
    </div>
  )}
</div>
