---
import type { Post } from "@/lib/blog";

import PostCardLink from "./PostCardLink.astro";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="divide-y [&>:not(:last-child)]:mb-5 [&>:not(:last-child)]:pb-5">
  {posts.map((post) => (
    <li class="post-item">
      <PostCardLink post={post} />
    </li>
  ))}
</ul>

<style>
  .post-item {
    @media (prefers-reduced-motion: no-preference) {
      --_duration: 75ms;

      opacity: 1;
      transition: opacity var(--_duration) ease-out;
      transition-delay: calc(sibling-index() * var(--_duration));

      @starting-style {
        opacity: 0;
      }
    }
  }
</style>
