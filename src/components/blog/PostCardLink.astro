---
import Badge from "@/components/ui/badge/Badge.astro";
import Link from "@/components/ui/link/Link.astro";
import type { Post } from "@/lib/blog";

import PostCardMetadata from "./PostCardMetadata.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const {
  data: { slug, title, description, tags },
} = post;
---

<Link
  class="group/post grid gap-3 sm:grid-cols-[7rem_minmax(0,1fr)] sm:items-baseline sm:gap-6"
  href={`/blog/${slug}`}
>
  <PostCardMetadata post={post} />

  <div class="flex flex-col gap-2">
    <h2 class="font-heading text-lg font-semibold tracking-tight transition-colors group-hover/post:text-primary">
      {title}
    </h2>

    <p class="text-muted-foreground">{description}</p>

    {tags.length > 0 && (
      <ul class="space-y-1.5 space-x-1.5">
        {tags.map((tag) => (
          <Badge as="li" variant="secondary">
            {tag}
          </Badge>
        ))}
      </ul>
    )}
  </div>
</Link>
