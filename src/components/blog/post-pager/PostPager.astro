---
import type { Post } from "@/lib/blog";

import PostNavigatorLink from "./PostPagerLink.astro";

interface Props {
  previous: Post | undefined;
  next: Post | undefined;
}

const { previous, next } = Astro.props;
---

{(previous || next) && (
  <nav class="grid grid-cols-2 gap-5">
    {previous && (
      <PostNavigatorLink
        position="previous"
        slug={previous.data.slug}
        title={previous.data.title}
      />
    )}

    {next && <PostNavigatorLink position="next" slug={next.data.slug} title={next.data.title} />}
  </nav>
)}
