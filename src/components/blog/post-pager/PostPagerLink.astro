---
import Link from "@/components/ui/link/Link.astro";
import { ChevronLeftIcon, ChevronRightIcon } from "@/config/icons";

interface Props {
  position: "previous" | "next";
  slug: string;
  title: string;
}

const { position, slug, title } = Astro.props;

const POSITION_CONFIG = {
  previous: {
    linkClass: "col-start-1",
    headerClass: "items-start",
    labelClass: "flex-row",
    label: "Previous",
    icon: ChevronLeftIcon,
  },
  next: {
    linkClass: "col-start-2",
    headerClass: "items-end text-right",
    labelClass: "flex-row-reverse",
    label: "Next",
    icon: ChevronRightIcon,
  },
} as const;

const { linkClass, headerClass, labelClass, label, icon: Icon } = POSITION_CONFIG[position];
---

<Link
  class:list={[
    "group col-span-1 flex flex-col gap-2 no-underline transition-colors hover:text-primary",
    headerClass,
    linkClass,
  ]}
  href={`/blog/${slug}`}
>
  <span
    class:list={[
      "flex flex-row items-center gap-1 text-xs font-medium tracking-widest text-muted-foreground uppercase",
      labelClass,
    ]}
  >
    <Icon class="size-4" />
    {label}
  </span>
  <span class="font-heading text-base font-semibold tracking-tight">{title}</span>
</Link>
