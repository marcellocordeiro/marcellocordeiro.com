---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  variant?: ButtonVariant;
  size?: ButtonSize;
}

const {
  class: className,
  variant = "default",
  size = "default",
  ...props
} = Astro.props;
---

<button
  type="button"
  class:list={["button", className]}
  data-slot="button"
  data-variant={variant}
  data-size={size}
  {...props}
>
  <slot />
</button>
