---
import type { HTMLAttributes } from "astro/types";

import { ArrowUpRightIcon } from "@/config/icons";
import { parseHref } from "@/lib/href-parser";

interface Props extends HTMLAttributes<"a"> {
  href: Route;
  showExternalLinkIcon?: boolean;
}

const { class: className, showExternalLinkIcon, href, ...props } = Astro.props;

const { isExternal, ...propsFromHref } = parseHref(href);
const resolvedShowExternalLinkIcon = showExternalLinkIcon ?? isExternal;
---

<a class:list={["link", className]} href={href} {...propsFromHref} {...props}>
  <slot />

  {resolvedShowExternalLinkIcon && <ArrowUpRightIcon data-icon="inline-end" aria-hidden="true" />}
  {isExternal && <span class="sr-only">(opens in a new tab)</span>}
</a>
