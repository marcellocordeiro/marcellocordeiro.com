---
import type { HTMLAttributes } from "astro/types";

import { parseHref } from "@/lib/href-parser";

interface Props extends HTMLAttributes<"a"> {
  href: Route;
  isIcon?: boolean;
}

const { class: className, isIcon, href, ...props } = Astro.props;

const { isExternal, ...propsFromHref } = parseHref(href);
---

<a
  class:list={["link", isIcon && "link-icon", isExternal && "external-link", className]}
  href={href}
  {...propsFromHref}
  {...props}
>
  <slot />
</a>
