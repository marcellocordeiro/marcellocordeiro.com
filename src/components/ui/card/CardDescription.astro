---
import type { HTMLAttributes } from "astro/types";
import { cn } from "cn";

type Props = HTMLAttributes<"div">;

const { class: className, ...props } = Astro.props;
---

<div
  data-slot="card-description"
  class={cn("text-sm text-muted-foreground", className)}
  {...props}
>
  <slot />
</div>
