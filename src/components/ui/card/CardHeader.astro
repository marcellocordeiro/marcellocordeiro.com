---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/utils";

type Props = HTMLAttributes<"div">;

const { class: className, ...props } = Astro.props;
---

<div
  data-slot="card-header"
  class={cn(
    "group/card-header grid auto-rows-min items-start gap-1.5 rounded-t-[min(var(--radius-4xl),24px)] px-(--card-spacing) has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] [.border-b]:pb-(--card-spacing)",
    // "@container/card-header", // https://github.com/shadcn-ui/ui/issues/7485
    className,
  )}
  {...props}
>
  <slot />
</div>
