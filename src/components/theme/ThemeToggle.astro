---
import ButtonGroup from "@/components/ui/button-group/ButtonGroup.astro";
import Button from "@/components/ui/button/Button.astro";
import { MonitorIcon, MoonIcon, SunIcon } from "@/config/icons";

const themes = [
  {
    theme: "light",
    label: "Light",
    Icon: SunIcon,
  },
  {
    theme: "system",
    label: "System",
    Icon: MonitorIcon,
  },
  {
    theme: "dark",
    label: "Dark",
    Icon: MoonIcon,
  },
] as const;
---

<theme-toggle transition:persist>
  <ButtonGroup role="radiogroup">
    {themes.map((item) => (
      <Button
        class="button-group-item"
        // oxlint-disable-next-line jsx-a11y/prefer-tag-over-role
        role="radio"
        variant="outline"
        data-value={item.theme}
        aria-label={`Switch theme to ${item.label}`}
        aria-checked="false"
      >
        <item.Icon />
      </Button>
    ))}
  </ButtonGroup>
</theme-toggle>

<style>
  theme-toggle {
    display: contents;
  }
</style>

<script is:inline>
  const selectedTheme = localStorage.getItem("theme") ?? "system";

  document.querySelectorAll(`button[data-value="${selectedTheme}"]`).forEach((button) => {
    button.dataset.variant = "default";
    button.setAttribute("aria-checked", "true");
  });
</script>

<script>
  import {
    DARK_MODE_MEDIA_QUERY,
    getSavedTheme,
    isTheme,
    updateDOMTheme,
    updateTheme,
    type Theme,
  } from "./theme";

  class ThemeToggle extends HTMLElement {
    #currentTheme: Theme = getSavedTheme() ?? "system";
    #abortController: AbortController | null = null;

    connectedCallback() {
      this.#abortController = new AbortController();
      const { signal } = this.#abortController;

      const buttons = this.querySelectorAll<HTMLButtonElement>("button[data-value]");

      // We're first synchronising in the inline script above, but keep it here as a reminder
      // this.syncButtons(this.currentTheme, buttons);

      buttons.forEach((button) => {
        button.addEventListener(
          "click",
          () => {
            const { value } = button.dataset;

            if (!isTheme(value)) {
              console.warn(`Invalid theme value: ${value}`);
              return;
            }

            this.#handleThemeChange(value, buttons);
          },
          { signal },
        );
      });

      globalThis
        .matchMedia(DARK_MODE_MEDIA_QUERY)
        .addEventListener("change", this.#handleMediaQueryChange, { signal });
    }

    disconnectedCallback() {
      this.#abortController?.abort();
      this.#abortController = null;
    }

    #handleMediaQueryChange = (event: MediaQueryListEvent) => {
      // Only update the DOM if the user did not set any preference
      if (this.#currentTheme !== "system") {
        return;
      }

      const theme = event.matches ? "dark" : "light";

      updateDOMTheme(theme);
    };

    #handleThemeChange = (selected: Theme, buttons: NodeListOf<HTMLButtonElement>) => {
      this.#currentTheme = selected;
      this.#syncButtons(selected, buttons);

      updateTheme(selected);
    };

    #syncButtons = (selected: Theme, buttons: NodeListOf<HTMLButtonElement>) => {
      buttons.forEach((button) => {
        const { value } = button.dataset;
        const variant = value === selected ? "default" : "outline";

        button.dataset["variant"] = variant;
        button.setAttribute("aria-checked", String(button.dataset["value"] === selected));
      });
    };
  }

  customElements.define("theme-toggle", ThemeToggle);
</script>
