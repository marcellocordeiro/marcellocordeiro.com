---
import Badge from "@/components/ui/badge/Badge.astro";
import Link from "@/components/ui/link/Link.astro";
import Separator from "@/components/ui/Separator.astro";
import { type Project } from "@/lib/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="flex w-full flex-col gap-y-6">
  {projects.map((project, index) => (
    <>
      <article class="flex min-w-0 flex-col gap-2">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <h2 class="font-heading text-lg font-semibold tracking-tight">
            {project.data.title}
          </h2>
          <div class="flex shrink-0 gap-x-4 text-sm">
            <Link href={project.data.repository}>GitHub</Link>
            {project.data.demo && (
              <Link href={project.data.demo}>Live demo</Link>
            )}
          </div>
        </div>

        <p class="text-muted-foreground">{project.data.description}</p>

        <ul
          class="flex flex-wrap gap-1.5"
          aria-label={`${project.data.title} technologies`}
        >
          {project.data.technologies.map((technology) => (
            <Badge as="li" variant="secondary">
              {technology}
            </Badge>
          ))}
        </ul>
      </article>
      {index < projects.length - 1 && <Separator />}
    </>
  ))}
</div>
